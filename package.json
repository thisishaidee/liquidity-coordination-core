{
  "name": "liquidity-coordination-core",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:dashboard && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build:dashboard && tsc --noEmit",
    "deploy": "npm run build:dashboard && wrangler deploy",
    "build:dashboard": "node scripts/embed-dashboard.mjs && npm run build:landing && npm run build:control && npm run build:business-dashboard && npm run build:pixel-field",
    "build:landing": "node scripts/embed-landing.mjs",
    "build:control": "node scripts/embed-control.mjs",
    "build:business-dashboard": "node scripts/embed-business-dashboard.mjs",
    "build:pixel-field": "node scripts/embed-pixel-field.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@solana-program/token": "0.18.0",
    "@solana/web3.js": "3.2.1"
  }
}
